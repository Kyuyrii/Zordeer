<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.kyuyrii.zordeer</id>
  <url type="homepage">https://github.com/Kyuyrii/Zordeer</url>
  <url type="bugtracker">https://github.com/Kyuyrii/Zordeer/issues</url>
  <url type="vcs-browser">https://github.com/Kyuyrii/Zordeer</url>
  <developer id="io.github.kyuyrii">
    <name>Kyuyrii</name>
  </developer>
  <name>Zordeer</name>
  <summary>A simple Qt game launcher</summary>

  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
  </recommends>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <content_rating type="oars-1.1"/>
  <categories>
    <category>Game</category>
    <category>PackageManager</category>
  </categories>
  <description>
    <p>
      A Qt launcher for games that run via Wine/Proton/UMU. Designed to work both inside and outside the Snapd and Flatpak sandboxes.
    </p>
  </description>
  <releases>
    <release version="8.0" date="2026-11-05">
      <description>
        <ul>
          <li>The shortcut manager now uses tabs instead of combo boxes, in an attempt to ensure that the user's choices are respected.</li>
          <li>Replaced python-dbus with QtDBus</li>
          <li>Proton-Sarek was removed; DXVK-Sarek is now available in Proton-CachyOS</li>
          <li>Proton-EM was removed</li>
          <li>Terminal messages are now all in English and start with [Zordeer]:</li>
        </ul>
      </description>
    </release>
  </releases>
  <launchable type="desktop-id">io.github.kyuyrii.zordeer.desktop</launchable>
  <branding>
    <color type="primary" scheme_preference="light">#232634</color>
    <color type="primary" scheme_preference="dark">#232634</color>
  </branding>
  <screenshots>
    <screenshot type="default">
      <image width="1684" height="1030">https://raw.githubusercontent.com/Kyuyrii/Zordeer/5c8e56b14ebeefc11ee095783fcd56460fbbe880/metainfo/zordeer_kde_neon.png</image>
      <caption>Zordeer on KDE Neon</caption>
    </screenshot>

    <screenshot>
      <image width="1568" height="900">https://raw.githubusercontent.com/Kyuyrii/Zordeer/5c8e56b14ebeefc11ee095783fcd56460fbbe880/metainfo/zordeer_lubuntu.png</image>
      <caption>Zordeer on Lubuntu</caption>
    </screenshot>
  </screenshots>

</component>
